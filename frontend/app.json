{
  "expo": {
    "name": "QuoteCanvas",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.quotecanvas.ylilp2",
      "infoPlist": {
        "NSCameraUsageDescription": "Snap book pages to turn quotes into graphics",
        "NSPhotoLibraryUsageDescription": "Pick page photos to extract quotes",
        "NSPhotoLibraryAddUsageDescription": "Save your quote graphics to Photos"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.emergent.quotecanvas.ylilp2",
      "permissions": ["android.permission.CAMERA", "android.permission.READ_MEDIA_IMAGES", "android.permission.WRITE_EXTERNAL_STORAGE"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-font",
      "expo-image",
      [
        "expo-camera",
        {
          "cameraPermission": "Snap book pages to turn quotes into graphics"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Pick page photos to extract quotes",
          "savePhotosPermission": "Save your quote graphics to Photos"
        }
      ],
      "expo-image-picker",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "expo-sharing",
      "@react-native-vector-icons/feather"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
